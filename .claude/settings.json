{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-secrets.sh",
            "args": [],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(**/*.ts)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/lint-changed.sh",
            "args": [],
            "timeout": 30,
            "statusMessage": "prettier + eslint"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-file-size.sh",
            "args": [],
            "timeout": 15,
            "statusMessage": "file-size guardrail"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-folder-file-count.sh",
            "args": [],
            "timeout": 15,
            "statusMessage": "folder file-count guardrail"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-verify.sh",
            "args": [],
            "timeout": 180,
            "statusMessage": "tsc + тесты + страж покрытия"
          }
        ]
      }
    ]
  }
}
